{
  "$schema": "https://developer.microsoft.com/json-schemas/spfx-build/config.2.0.schema.json",
  "version": "2.0",
  "bundles": {
    "product-catalogue-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/productCatalogue/ProductCatalogueWebPart.js",
          "manifest": "./src/webparts/productCatalogue/ProductCatalogueWebPart.manifest.json"
        }
      ]
    },
    "sales-dashboard-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/salesDashboard/SalesDashboardWebPart.js",
          "manifest": "./src/webparts/salesDashboard/SalesDashboardWebPart.manifest.json"
        }
      ]
    },
    "inventory-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/inventory/InventoryWebPart.js",
          "manifest": "./src/webparts/inventory/InventoryWebPart.manifest.json"
        }
      ]
    },
    "admin-dashboard-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/adminDashboard/AdminDashboardWebPart.js",
          "manifest": "./src/webparts/adminDashboard/AdminDashboardWebPart.manifest.json"
        }
      ]
    }
  },
  "externals": {},
  "localizedResources": {
    "ProductCatalogueWebPartStrings": "lib/webparts/productCatalogue/loc/{locale}.js",
    "SalesDashboardWebPartStrings": "lib/webparts/salesDashboard/loc/{locale}.js",
    "InventoryWebPartStrings": "lib/webparts/inventory/loc/{locale}.js",
    "AdminDashboardWebPartStrings": "lib/webparts/adminDashboard/loc/{locale}.js"
  }
}
